#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<HistoryButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.after:
        Color:
            rgba: (1, 0.60, 0.08, 1)
        Line:
            circle: (self.center_x, self.center_y, dp(10))
            width: dp(1.8)
        Line:
            points: (self.center_x, self.center_y, self.center_x, self.center_y + dp(6), self.center_x + dp(5), self.center_y + dp(3))
            width: dp(1.8)
            cap: "square"
        Line:
            points: (self.center_x - dp(13), self.center_y + dp(7), self.center_x - dp(13), self.center_y + dp(13), self.center_x - dp(7), self.center_y + dp(13))
            width: dp(1.8)
            cap: "square"

<BackspaceButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.20, 0.20, 0.21, 1)
    canvas.after:
        Color:
            rgba: (1, 1, 1, 1)
        Line:
            points: (self.center_x - dp(14), self.center_y, self.center_x - dp(6), self.center_y + dp(9), self.center_x + dp(14), self.center_y + dp(9), self.center_x + dp(14), self.center_y - dp(9), self.center_x - dp(6), self.center_y - dp(9), self.center_x - dp(14), self.center_y)
            close: True
            width: dp(1.8)
        Line:
            points: (self.center_x, self.center_y + dp(4), self.center_x + dp(8), self.center_y - dp(4))
            width: dp(1.8)
        Line:
            points: (self.center_x, self.center_y - dp(4), self.center_x + dp(8), self.center_y + dp(4))
            width: dp(1.8)

<CalcButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.20, 0.20, 0.21, 1)
    color: 1, 1, 1, 1
    font_size: "25sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: (self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2)
            size: (min(self.width, self.height), min(self.width, self.height))

<UtilityButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.65, 0.65, 0.66, 1)
    color: 0.04, 0.04, 0.05, 1
    font_size: "22sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: (self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2)
            size: (min(self.width, self.height), min(self.width, self.height))

<OperatorButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (1, 0.60, 0.08, 1)
    color: 1, 1, 1, 1
    font_size: "27sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: (self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2)
            size: (min(self.width, self.height), min(self.width, self.height))

BoxLayout:
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: 0.60
        orientation: "vertical"
        padding: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(38)
            Label:
                text: "CALCULATOR"
                color: 0.55, 0.55, 0.57, 1
                font_size: "14sp"
                halign: "left"
            HistoryButton:
                size_hint_x: None
                width: dp(48)
                on_press: app.on_history()

        Label:
            id: expression
            text: ""
            color: 0.65, 0.65, 0.67, 1
            font_size: "23sp"
            halign: "right"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "left"

        Label:
            id: display
            text: "0"
            color: 1, 1, 1, 1
            font_size: max(sp(1), min(sp(64), self.width * 1.5 / max(1, len(self.text))))
            halign: "right"
            valign: "middle"
            text_size: self.size
            shorten: False

    BoxLayout:
        id: history_panel
        opacity: 0
        disabled: True
        size_hint_y: None
        height: dp(100) if self.opacity else 0
        Label:
            id: history
            text: "No recent calculations"
            color: 0.85, 0.85, 0.86, 1
            font_size: "14sp"
            halign: "right"
            valign: "middle"
            text_size: self.size

    GridLayout:
        cols: 4
        spacing: dp(10)
        size_hint_y: 1
        row_default_height: max(0, (self.height - self.spacing[1] * 4) / 5)
        row_force_default: True

        UtilityButton:
            id: clear_button
            text: "AC"
            on_press: app.on_button("AC")
        UtilityButton:
            text: "+/-"
            on_press: app.on_button("+/-")
        UtilityButton:
            text: "%"
            on_press: app.on_button("%")
        OperatorButton:
            text: "÷"
            on_press: app.on_button("/")
        CalcButton:
            text: "7"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "8"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "9"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "×"
            on_press: app.on_button("*")

        CalcButton:
            text: "4"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "5"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "6"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "−"
            on_press: app.on_button("-")

        CalcButton:
            text: "1"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "2"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "3"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "+"
            on_press: app.on_button("+")

        BackspaceButton:
            on_press: app.on_button("DEL")
        CalcButton:
            text: "0"
            on_press: app.on_button("0")
        CalcButton:
            text: "."
            on_press: app.on_button(".")
        OperatorButton:
            text: "="
            on_press: app.on_button("=")
