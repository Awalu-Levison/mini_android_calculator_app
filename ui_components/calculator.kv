#:import dp kivy.metrics.dp

<CalcButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.20, 0.20, 0.21, 1)
    color: 1, 1, 1, 1
    font_size: "25sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: self.pos
            size: self.size

<UtilityButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.65, 0.65, 0.66, 1)
    color: 0.04, 0.04, 0.05, 1
    font_size: "22sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: self.pos
            size: self.size

<OperatorButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (1, 0.60, 0.08, 1)
    color: 1, 1, 1, 1
    font_size: "27sp"
    canvas.before:
        Color:
            rgba: self.background_color
        Ellipse:
            pos: self.pos
            size: self.size

BoxLayout:
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: 0.30
        orientation: "vertical"
        padding: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(38)
            Label:
                text: "CALCULATOR"
                color: 0.55, 0.55, 0.57, 1
                font_size: "14sp"
                halign: "left"
            Button:
                text: "◷"
                size_hint_x: None
                width: dp(45)
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 1, 0.60, 0.08, 1
                font_size: "25sp"
                on_press: app.on_history()

        Label:
            id: expression
            text: ""
            color: 0.65, 0.65, 0.67, 1
            font_size: "23sp"
            halign: "right"
            valign: "bottom"
            text_size: self.size
            shorten: True
            shorten_from: "left"

        Label:
            id: display
            text: "0"
            color: 1, 1, 1, 1
            font_size: "64sp"
            halign: "right"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "left"

    BoxLayout:
        id: history_panel
        opacity: 0
        disabled: True
        size_hint_y: None
        height: dp(100) if self.opacity else 0
        Label:
            id: history
            text: "No recent calculations"
            color: 0.85, 0.85, 0.86, 1
            font_size: "14sp"
            halign: "right"
            valign: "middle"
            text_size: self.size

    GridLayout:
        cols: 4
        spacing: dp(10)
        size_hint_y: 0.62
        row_default_height: dp(56)
        row_force_default: True

        UtilityButton:
            id: clear_button
            text: "AC"
            on_press: app.on_button("AC")
        UtilityButton:
            text: "+/-"
            on_press: app.on_button("+/-")
        UtilityButton:
            text: "%"
            on_press: app.on_button("%")
        OperatorButton:
            text: "÷"
            on_press: app.on_button("/")

        CalcButton:
            text: "7"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "8"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "9"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "×"
            on_press: app.on_button("*")

        CalcButton:
            text: "4"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "5"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "6"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "−"
            on_press: app.on_button("-")

        CalcButton:
            text: "1"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "2"
            on_press: app.on_button(self.text)
        CalcButton:
            text: "3"
            on_press: app.on_button(self.text)
        OperatorButton:
            text: "+"
            on_press: app.on_button("+")

        CalcButton:
            text: "⌫"
            on_press: app.on_button("⌫")
        CalcButton:
            text: "0"
            on_press: app.on_button("0")
        CalcButton:
            text: "."
            on_press: app.on_button(".")
        OperatorButton:
            text: "="
            on_press: app.on_button("=")
